// OpenBuild Gallery — data model for the seed product (the Poll clone).
// Design note on correctness-under-load: votes are an APPEND-ONLY table, and
// the tally is a COUNT over that table. There is no mutable counter to race on,
// so lost updates are impossible by construction. The two unique constraints on
// Vote enforce the two invariants candidates must not break:
//   - one vote per (poll, voter)      -> no double-vote across tabs
//   - one effect per idempotency key  -> safe client retries
// Concurrent writers that collide on either index lose with a unique violation,
// which the API translates into a clean 409 / idempotent replay — never a 500.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // one vote per voter per poll
  @@unique([pollId, voterId])
  // one effect per idempotency key, scoped to the poll (safe retries; keys are
  // meaningful within a poll, so two different polls can reuse a key name)
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model Shortlink {
  code      String   @id
  url       String
  lookupKey String   @unique // alias OR "default:" + url
  createdAt DateTime @default(now())

  @@index([url])
}

model Paste {
  id             String   @id @default(cuid())
  content        String
  viewsAllowed   Int
  viewsRemaining Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([expiresAt])
  @@index([viewsRemaining])
}

model Account {
  id        String   @id @default(cuid())
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  ledger    LedgerEntry[]
}

model LedgerEntry {
  id              String        @id @default(cuid())
  accountId       String
  type            LedgerType
  amount          BigInt
  counterpartyId  String?
  idempotencyKey  String
  createdAt       DateTime      @default(now())
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, idempotencyKey])
  @@index([accountId])
}

enum LedgerType {
  DEPOSIT
  TRANSFER_IN
  TRANSFER_OUT
}

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  totalQty    Int
  reservedQty Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reservations Reservation[]

  @@index([sku])
}

model Reservation {
  id              String   @id @default(cuid())
  inventoryItemId String
  qty             Int
  idempotencyKey  String
  status          ReservationStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  releasedAt      DateTime?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, idempotencyKey])
  @@index([inventoryItemId])
  @@index([status])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
}

model Voucher {
  id          String   @id @default(cuid())
  code        String   @unique
  redeemed    Boolean  @default(false)
  redeemedBy  String?
  redeemedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([code])
}
