// OpenBuild Gallery â€” data model with RateLimitState for shared rate limiter.
// Token bucket algorithm: atomic UPDATE for correctness under hot-key burst.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model RateLimitState {
  key         String   @id
  tokens      Float
  lastRefill  DateTime @default(now())
}
