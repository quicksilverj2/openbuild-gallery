// OpenBuild Gallery â€” data model with Inventory clone.
// Never oversell: atomic UPDATE ... WHERE reservedUnits + units <= totalUnits.
// Idempotent: unique on idempotencyKey. Releasable: status field on Reservation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model InventoryItem {
  id             String        @id @default(cuid())
  cloneSlug      String
  name           String
  totalUnits     Int
  reservedUnits  Int           @default(0)
  createdAt      DateTime      @default(now())
  reservations   Reservation[]

  @@index([cloneSlug])
}

model Reservation {
  id             String   @id @default(cuid())
  itemId         String
  userId         String
  units          Int
  idempotencyKey String
  fingerprint    String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([itemId])
}
