// OpenBuild Gallery â€” data model with Shortlink clone.
// Design: URL unique index ensures dedup. Code unique index ensures no collisions.
// Alias unique index (nullable) ensures custom aliases don't clash.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model Shortlink {
  id        String   @id @default(cuid())
  cloneSlug String
  url       String
  code      String
  alias     String?
  createdAt DateTime @default(now())

  @@unique([url])
  @@unique([code])
  @@unique([alias])
  @@index([cloneSlug])
}
