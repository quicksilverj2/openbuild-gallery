// OpenBuild Gallery — data model for the seed product (the Poll clone).
// Design note on correctness-under-load: votes are an APPEND-ONLY table, and
// the tally is a COUNT over that table. There is no mutable counter to race on,
// so lost updates are impossible by construction. The two unique constraints on
// Vote enforce the two invariants candidates must not break:
//   - one vote per (poll, voter)      -> no double-vote across tabs
//   - one effect per idempotency key  -> safe client retries
// Concurrent writers that collide on either index lose with a unique violation,
// which the API translates into a clean 409 / idempotent replay — never a 500.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // one vote per voter per poll
  @@unique([pollId, voterId])
  // one effect per idempotency key, scoped to the poll (safe retries; keys are
  // meaningful within a poll, so two different polls can reuse a key name)
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

// Voucher clone: single-use redemption with atomic claim guarantee.
// Design notes (concurrency-under-load):
//   - code is the primary key — explicit human-readable voucher code.
//   - redeemedBy starts NULL and is atomically set by the redeem endpoint using
//     UPDATE ... WHERE "redeemedBy" IS NULL ... RETURNING *.
//   - If a concurrent redeemer already claimed the row, RETURNING produces an
//     empty set → clean 409, zero 5xx.
//   - redeemedAt records the moment of redemption for audit.
model Voucher {
  code       String    @id
  value      String
  redeemedBy String?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}
