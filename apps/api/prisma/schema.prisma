// OpenBuild Gallery — data model for the seed product (the Poll clone).
// Design note on correctness-under-load: votes are an APPEND-ONLY table, and
// the tally is a COUNT over that table. There is no mutable counter to race on,
// so lost updates are impossible by construction. The two unique constraints on
// Vote enforce the two invariants candidates must not break:
//   - one vote per (poll, voter)      -> no double-vote across tabs
//   - one effect per idempotency key  -> safe client retries
// Concurrent writers that collide on either index lose with a unique violation,
// which the API translates into a clean 409 / idempotent replay — never a 500.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // one vote per voter per poll
  @@unique([pollId, voterId])
  // one effect per idempotency key, scoped to the poll (safe retries; keys are
  // meaningful within a poll, so two different polls can reuse a key name)
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

// Shortlink clone: URL shortener with dedup and non-enumerable codes.
// Design notes:
//   - code is the primary key — auto-generated (8-char random) or explicit alias.
//   - @@unique([url]) ensures one row per URL (dedup invariant).
//   - concurrent /shorten of the same URL: first writer wins, others resolve to the
//     same code via the unique violation → lookup path (zero 5xx).
model Shortlink {
  code      String   @id
  url       String
  createdAt DateTime @default(now())

  @@unique([url])
}

// Paste clone: view-once or N-view paste with TTL.
// Design notes (concurrency-under-load):
//   - viewsAllowed and viewsUsed are separate columns so Postgres can atomically
//     evaluate `viewsUsed < viewsAllowed` inside a single-row UPDATE … WHERE.
//   - The read endpoint uses UPDATE … RETURNING * with that WHERE clause.
//     If the row was already exhausted by a concurrent reader the RETURNING set
//     is empty → clean 404/410, zero 5xx.
//   - expiresAt is a concrete timestamp (createdAt + ttlSeconds) so the DB can
//     filter expired pastes without client-side math.
model Paste {
  id           String   @id @default(cuid())
  content      String
  viewsAllowed Int
  viewsUsed    Int      @default(0)
  ttlSeconds   Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}
