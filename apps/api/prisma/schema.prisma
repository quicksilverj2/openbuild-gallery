// OpenBuild Gallery â€” data model with Voucher clone.
// Single-use: unique on voucherId ensures only one redemption per voucher.
// Idempotent: unique on (voucherId, userId) ensures same user retrying is a no-op.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model Voucher {
  id        String      @id @default(cuid())
  cloneSlug String
  code      String
  createdAt DateTime    @default(now())
  redemptions Redemption[]

  @@unique([code])
  @@index([cloneSlug])
}

model Redemption {
  id         String   @id @default(cuid())
  voucherId  String
  userId     String
  fingerprint String
  createdAt  DateTime @default(now())
  voucher    Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId])
  @@unique([voucherId, userId])
}
