// OpenBuild Gallery â€” data model with Wallet clone.
// Atomic transfers via DB transaction: debit + credit + ledger entry in one tx.
// Balance never negative: CHECK balancePaise >= 0 enforced in application logic.
// Idempotency: unique on idempotencyKey prevents double-transfer.
// Integer paise: all amounts stored as BIGINT paise (1 rupee = 100 paise).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model Wallet {
  id           String   @id @default(cuid())
  cloneSlug    String
  ownerId      String
  balancePaise BigInt   @default(0)
  createdAt    DateTime @default(now())

  @@unique([ownerId])
  @@index([cloneSlug])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  cloneSlug      String
  fromWalletId   String
  toWalletId     String
  amountPaise    BigInt
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  fromWallet     Wallet   @relation("FromWallet", fields: [fromWalletId], references: [id], onDelete: Cascade)
  toWallet       Wallet   @relation("ToWallet", fields: [toWalletId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([cloneSlug])
  @@index([fromWalletId])
  @@index([toWalletId])
}
