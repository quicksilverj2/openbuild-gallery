// OpenBuild Gallery — data model for the seed product (the Poll clone)
// and the Paste clone (view-once + TTL).
//
// Design note on correctness-under-load: votes are an APPEND-ONLY table, and
// the tally is a COUNT over that table. There is no mutable counter to race on,
// so lost updates are impossible by construction. The two unique constraints on
// Vote enforce the two invariants candidates must not break:
//   - one vote per (poll, voter)      -> no double-vote across tabs
//   - one effect per idempotency key  -> safe client retries
// Concurrent writers that collide on either index lose with a unique violation,
// which the API translates into a clean 409 / idempotent replay — never a 500.
//
// The Paste clone uses an atomic decrement on viewsRemaining to ensure that
// exactly viewsAllowed reads succeed, even under concurrent access. The
// UPDATE ... WHERE guard makes losing readers get a clean 404/410, never a 5xx.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clone {
  slug      String   @id
  title     String
  summary   String
  demoPath  String
  createdBy String   @default("seed")
  createdAt DateTime @default(now())
}

model Poll {
  id        String   @id @default(cuid())
  cloneSlug String
  question  String
  createdAt DateTime @default(now())
  options   Option[]
  votes     Vote[]

  @@index([cloneSlug])
}

model Option {
  id        String   @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([pollId])
}

model Vote {
  id             String   @id @default(cuid())
  pollId         String
  optionId       String
  voterId        String
  idempotencyKey String
  fingerprint    String
  createdAt      DateTime @default(now())
  poll           Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option         Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
  @@unique([pollId, idempotencyKey])
  @@index([pollId])
}

model Paste {
  id             String   @id @default(cuid())
  cloneSlug      String
  content        String
  viewsAllowed   Int
  viewsRemaining Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([cloneSlug])
}
